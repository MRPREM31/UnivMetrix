# =============================================================================
# MetalPrice Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Client-Side Variables (Vite / Browser - Safe for Public Bundle)
# -----------------------------------------------------------------------------
# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (Read-only access via RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Preferred data mode ('auto' | 'demo' | 'supabase')
VITE_DATA_SOURCE_MODE=auto

# -----------------------------------------------------------------------------
# 2. Server-Side Variables (Vercel Serverless Functions Only - NEVER EXPOSE TO VITE_)
# -----------------------------------------------------------------------------
# Supabase Service Role Secret Key (Required for cron ingestion to write observations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key

# Primary Price Provider: GoldAPI.io (Get free API key at https://www.goldapi.io)
GOLDAPI_KEY=goldapi-xxxxxx-xxxxxx

# Alternative Provider: MetalpriceAPI (Optional fallback, get key at https://metalpriceapi.com)
METALPRICE_API_KEY=your_metalprice_key_here

# Secret token to protect the /api/cron/update-prices endpoint
CRON_SECRET=your_custom_random_cron_secret_string
